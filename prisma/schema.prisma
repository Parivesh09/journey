generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DsaStatus {
  NOT_STARTED
  ATTEMPTED
  SOLVED
  NEEDS_REVISION
}

enum TopicStatus {
  NOT_STARTED
  LEARNING
  COMPLETED
  NEEDS_REVISION
}

enum NotificationChannel {
  BROWSER
  EMAIL
  TELEGRAM
  LINQ
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

model User {
  id                      String    @id @default(cuid())
  name                    String?
  email                   String    @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  isActive                Boolean   @default(true)
  timezone                String    @default("UTC")
  onboardingDismissedAt   DateTime?
  dailyStudyTargetMinutes Int       @default(240)
  theme                   String    @default("dark")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tasks                   Task[]
  taskCompletions         TaskCompletion[]
  dailyTaskPins           DailyTaskPin[]
  userRoadmaps            UserRoadmap[]
  userMilestones          UserMilestone[]
  studySessions           StudySession[]
  notifications           Notification[]
  notificationPreferences NotificationPreference?
  integrations            UserIntegration[]
  logs                    NotificationLog[]
}

model TaskCategory {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
}

model Task {
  id               String       @id @default(cuid())
  userId           String
  title            String
  description      String?
  categoryId       String?
  priority         TaskPriority @default(MEDIUM)
  estimatedMinutes Int?
  dueDate          DateTime?
  status           TaskStatus   @default(TODO)
  completedAt      DateTime?
  taskType         String?
  difficulty       String?
  sourceId         String?
  phaseId          String?
  phaseTitle       String?
  topicId          String?
  topicTitle       String?
  roadmapId        String?
  milestoneId      String?
  milestoneTitle   String?
  sequenceOrder    Int          @default(0)
  dailySlot        String?
  plannedMinutes   Int?
  isDailyTask      Boolean      @default(false)
  isPersonalDaily  Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      TaskCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  studySessions StudySession[]
  notifications Notification[]
  completions   TaskCompletion[]
  dailyPins     DailyTaskPin[]

  @@unique([userId, sourceId])
  @@index([userId, sequenceOrder])
  @@index([userId, phaseId])
  @@index([userId, topicId])
  @@index([userId, dueDate])
  @@index([userId, dueDate, isDailyTask])
  @@index([userId, roadmapId, isPersonalDaily])
}

model StudyPlan {
  id                String   @id @default(cuid())
  userId            String
  goal              String
  durationDays      Int
  dailyStudyMinutes Int
  weeklyTargets     String?
  topics            String?
  revisionSchedule  String?
  mockInterviews    String?
  projects          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String
  taskId          String?
  durationMinutes Int
  startedAt       DateTime
  endedAt         DateTime
  createdAt       DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model DailyPlan {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskCompletion {
  id          String   @id @default(cuid())
  userId      String
  taskId      String
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, completedAt])
}

model DailyTaskPin {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId, createdAt])
}

model UserRoadmap {
  id          String   @id @default(cuid())
  userId      String
  roadmapId   String
  activatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
}

model UserMilestone {
  id                  String    @id @default(cuid())
  userId              String
  roadmapId           String
  milestoneId         String
  manuallyCompletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId, milestoneId])
}

model Notification {
  id                  String              @id @default(cuid())
  userId              String
  taskId              String?
  reminderKey         String?             @unique
  provider            String
  channel             NotificationChannel
  title               String
  message             String
  status              NotificationStatus  @default(QUEUED)
  scheduledFor        DateTime?
  providerMessageId   String?
  lastProviderEvent   String?
  lastProviderEventAt DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model NotificationPreference {
  id                        String              @id @default(cuid())
  userId                    String              @unique
  browserEnabled            Boolean             @default(false)
  emailEnabled              Boolean             @default(false)
  telegramEnabled           Boolean             @default(false)
  linqEnabled               Boolean             @default(false)
  smsEnabled                Boolean             @default(false)
  whatsappEnabled           Boolean             @default(false)
  phoneNumber               String?
  reminderSchedule          Json?
  overdueRemindersEnabled   Boolean             @default(false)
  excludeCompletedTasks     Boolean             @default(true)
  dailyReminderEnabled      Boolean             @default(false)
  missedTaskReminderEnabled Boolean             @default(false)
  revisionReminderEnabled   Boolean             @default(false)
  weeklySummaryEnabled      Boolean             @default(false)
  weeklySummaryDay          Int                 @default(0) // 0=Sunday .. 6=Saturday, in the user's local timezone
  quietHoursEnabled         Boolean             @default(true)
  quietHoursStart           String              @default("22:00")
  quietHoursEnd             String              @default("07:00")
  maxDailyNotifications     Int                 @default(5)
  minNotificationInterval   Int                 @default(30)
  preferredChannel          NotificationChannel @default(BROWSER)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id                String              @id @default(cuid())
  userId            String
  notificationId    String?
  provider          String
  providerMessageId String?
  channel           NotificationChannel
  status            NotificationStatus  @default(QUEUED)
  title             String
  message           String
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserIntegration {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  enabled        Boolean  @default(false)
  telegramChatId String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
