generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DsaStatus {
  NOT_STARTED
  ATTEMPTED
  SOLVED
  NEEDS_REVISION
}

enum TopicStatus {
  NOT_STARTED
  LEARNING
  COMPLETED
  NEEDS_REVISION
}

enum NotificationChannel {
  BROWSER
  EMAIL
  TELEGRAM
  LINQ
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  READ
}

// ====================
// AI Provider System
// ====================

enum AIProviderType {
  SYSTEM
  CUSTOM
}

enum AIProtocol {
  OPENAI_COMPATIBLE
  ANTHROPIC_MESSAGES
  GOOGLE_GEMINI
  OLLAMA
  LM_STUDIO
}

enum AIStatus {
  ENABLED
  DISABLED
}

// Provider definitions (system and built-in provider specifications)
model AIProviderDefinition {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  type        AIProviderType
  protocol    AIProtocol
  capabilities Json    // AIProviderCapabilities as JSON
  endpoint     String?
  apiKeyRequired Boolean @default(true)
  supportsModelDiscovery Boolean @default(false)
  documentationUrl String?
  metadata     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  providers    AIProvider[]
}

// User/admin configured AI providers
model AIProvider {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  type            AIProviderType
  protocol        AIProtocol
  status          AIStatus  @default(ENABLED)
  endpoint        String
  model           String?
  capabilities    Json?    // AIProviderCapabilities as JSON
  configuration    Json?   // Additional configuration metadata
  metadata        Json?    // Any additional metadata
  isDefault       Boolean  @default(false)
  isSystem        Boolean  @default(false)
  isManagedByEnv  Boolean  @default(false)  // Whether this provider's config comes from environment
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  definition      AIProviderDefinition? @relation(fields: [definitionId], references: [id])
  definitionId    String?
  secrets         AIProviderSecret[] @relation("AIProviderSecretProvider")
  diagrams        ArchifyDiagram[]
}

// Encrypted API key storage
model AIProviderSecret {
  id              String   @id @default(cuid())
  userId           String   // User who owns this API key
  providerId       String
  encryptedApiKey  String   // Encrypted API key using AES-256-GCM
  version          Int      @default(1)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user             User      @relation("AIProviderSecretUser", fields: [userId], references: [id], onDelete: Cascade)
  provider         AIProvider  @relation("AIProviderSecretProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId, version])
  @@index([userId, providerId])
}

model User {
  id                      String    @id @default(cuid())
  name                    String?
  email                   String    @unique
  emailVerified           DateTime?
  image                   String?
  passwordHash            String?
  isActive                Boolean   @default(true)
  timezone                String    @default("UTC")
  onboardingDismissedAt   DateTime?
  dailyStudyTargetMinutes Int       @default(240)
  theme                   String    @default("dark")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tasks                   Task[]
  taskCompletions         TaskCompletion[]
  dailyTaskPins           DailyTaskPin[]
  userDailyRoadmaps       UserDailyRoadmap[]
  userRoadmaps            UserRoadmap[]
  userMilestones          UserMilestone[]
  studySessions           StudySession[]
  notifications           Notification[]
  notificationPreferences NotificationPreference?
  integrations            UserIntegration[]
  logs                    NotificationLog[]
  aiProviderSecrets       AIProviderSecret[] @relation("AIProviderSecretUser")
}

model TaskCategory {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]
}

model Task {
  id               String       @id @default(cuid())
  userId           String
  title            String
  description      String?
  categoryId       String?
  priority         TaskPriority @default(MEDIUM)
  estimatedMinutes Int?
  dueDate          DateTime?
  startTime        DateTime?
  endTime          DateTime?
  status           TaskStatus   @default(TODO)
  completedAt      DateTime?
  taskType         String?
  difficulty       String?
  sourceId         String?
  phaseId          String?
  phaseTitle       String?
  topicId          String?
  topicTitle       String?
  roadmapId        String?
  milestoneId      String?
  milestoneTitle   String?
  sequenceOrder    Int          @default(0)
  dailySlot        String?
  plannedHours     Int?
  plannedMinutes   Int?
  plannedSeconds   Int?
  isDailyTask      Boolean      @default(false)
  isPersonalDaily  Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      TaskCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  studySessions StudySession[]
  notifications Notification[]
  completions   TaskCompletion[]
  dailyPins     DailyTaskPin[]

  @@unique([userId, sourceId])
  @@index([userId, sequenceOrder])
  @@index([userId, phaseId])
  @@index([userId, topicId])
  @@index([userId, dueDate])
  @@index([userId, dueDate, isDailyTask])
  @@index([userId, roadmapId, isPersonalDaily])
}

model StudyPlan {
  id                String   @id @default(cuid())
  userId            String
  goal              String
  durationDays      Int
  dailyStudyMinutes Int
  weeklyTargets     String?
  topics            String?
  revisionSchedule  String?
  mockInterviews    String?
  projects          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String
  taskId          String?
  durationMinutes Int
  startedAt       DateTime
  endedAt         DateTime
  createdAt       DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model DailyPlan {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskCompletion {
  id          String   @id @default(cuid())
  userId      String
  taskId      String
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, completedAt])
}

model DailyTaskPin {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId, createdAt])
}

model UserDailyRoadmap {
  id        String   @id @default(cuid())
  userId    String
  roadmapId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
  @@index([userId])
}

model UserRoadmap {
  id          String   @id @default(cuid())
  userId      String
  roadmapId   String
  activatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
}

model UserMilestone {
  id                  String    @id @default(cuid())
  userId              String
  roadmapId           String
  milestoneId         String
  manuallyCompletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId, milestoneId])
}

model Notification {
  id                  String              @id @default(cuid())
  userId              String
  taskId              String?
  reminderKey         String?             @unique
  provider            String
  channel             NotificationChannel
  title               String
  message             String
  status              NotificationStatus  @default(QUEUED)
  scheduledFor        DateTime?
  providerMessageId   String?
  lastProviderEvent   String?
  lastProviderEventAt DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model NotificationPreference {
  id                        String              @id @default(cuid())
  userId                    String              @unique
  browserEnabled            Boolean             @default(false)
  emailEnabled              Boolean             @default(false)
  telegramEnabled           Boolean             @default(false)
  linqEnabled               Boolean             @default(false)
  smsEnabled                Boolean             @default(false)
  whatsappEnabled           Boolean             @default(false)
  phoneNumber               String?
  reminderSchedule          Json?
  overdueRemindersEnabled   Boolean             @default(false)
  excludeCompletedTasks     Boolean             @default(true)
  dailyReminderEnabled      Boolean             @default(false)
  missedTaskReminderEnabled Boolean             @default(false)
  revisionReminderEnabled   Boolean             @default(false)
  weeklySummaryEnabled      Boolean             @default(false)
  weeklySummaryDay          Int                 @default(0) // 0=Sunday .. 6=Saturday, in the user's local timezone
  quietHoursEnabled         Boolean             @default(true)
  quietHoursStart           String              @default("22:00")
  quietHoursEnd             String              @default("07:00")
  maxDailyNotifications     Int                 @default(5)
  minNotificationInterval   Int                 @default(30)
  preferredChannel          NotificationChannel @default(BROWSER)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id                String              @id @default(cuid())
  userId            String
  notificationId    String?
  provider          String
  providerMessageId String?
  channel           NotificationChannel
  status            NotificationStatus  @default(QUEUED)
  title             String
  message           String
  errorCode         String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserIntegration {
  id             String   @id @default(cuid())
  userId         String
  provider       String
  enabled        Boolean  @default(false)
  telegramChatId String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoadmapVisualizationConfig {
  id                  String   @id @default(cuid())
  roadmapId           String   @unique
  archifyEnabled      Boolean  @default(false)
  defaultDiagramType  String   @default("architecture")
  allowedDiagramTypes String[] @default(["architecture"])
  aiGenerationEnabled Boolean  @default(false)
  generationStrategy  String?
  regenerationPolicy  String?
  maxNodes            Int?
  promptVersion       String   @default("1")
  generationVersion   String   @default("1")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  diagrams ArchifyDiagram[]
}

// Archify diagram with provider reference
model ArchifyDiagram {
  id              String    @id @default(cuid())
  roadmapId       String
  diagramType     String
  sourceJson      Json
  sourceHash      String
  roadmapVersion  String
  generationVersion String
  promptVersion   String
  status          String    @default("ready")
  errorMetadata   Json?
  renderedHtml    String?
  
  // Provider reference
  providerId      String?
  modelUsed       String?
  
  generatedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  config          RoadmapVisualizationConfig @relation(fields: [roadmapId], references: [roadmapId], onDelete: Cascade)
  provider        AIProvider?                @relation(fields: [providerId], references: [id])

  @@index([roadmapId, diagramType])
  @@index([roadmapId, status])
  @@unique([roadmapId, diagramType, roadmapVersion])
  @@index([providerId])
}